{
  "name": "town-weather-hub-template",
  "private": true,
  "description": "Tests for the town weather hub static site (the site itself has no build step).",
  "scripts": {
    "test": "node scripts/run-tests.js",
    "check-config": "node scripts/check-config.js",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:py": "python3 -m unittest discover -s tests/python -v",
    "test:e2e": "playwright test",
    "check-config:online": "node scripts/check-config.js --online"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
